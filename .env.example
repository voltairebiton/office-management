# Required for staff authentication. Keep actual values in .env.local.
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional for future WorkOS organization/member management API calls.
WORKOS_API_KEY=

# Neon Postgres pooled connection string for the application.
DATABASE_URL=

# Direct connection for migrations. Falls back to DATABASE_URL when omitted.
DIRECT_DATABASE_URL=

# Explicitly separate PostgreSQL database for tests; never set this to the application database.
TEST_DATABASE_URL=
