# Required for staff authentication and authoritative membership checks. Keep actual values in .env.local.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Neon Postgres pooled connection string for the application.
DATABASE_URL=

# Direct connection for migrations. Falls back to DATABASE_URL when omitted.
DIRECT_DATABASE_URL=

# Explicitly separate PostgreSQL database for tests; never set this to the application database.
TEST_DATABASE_URL=

# Configure after creating a WorkOS webhook endpoint; never commit the signing secret.
WORKOS_WEBHOOK_SECRET=

# Set these only for the explicit first-admin bootstrap command.
BOOTSTRAP_WORKOS_USER_ID=
BOOTSTRAP_WORKOS_ORGANIZATION_ID=
