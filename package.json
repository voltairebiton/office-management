{
  "name": "office-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-db.js",
    "db:check": "node scripts/check-db.js",
    "test:db": "node --conditions=react-server --test tests/database.test.js tests/identity-database.test.js",
    "test": "node --test tests/unit/*.test.js",
    "db:migrate:test": "node scripts/migrate-test-db.js",
    "test:e2e": "playwright test",
    "workos:bootstrap-admin": "node --conditions=react-server scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@workos-inc/authkit-nextjs": "^4.6.3",
    "@workos-inc/node": "^12.3.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3"
  },
  "description": "Multi-tenant office management with Next.js, room inventory, visitor management, and QR refreshment ordering.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voltairebiton/office-management.git"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "type": "module"
}
